  "builderRows": [
    {
      "id": "builder-app-id",
      "path": "appId",
      "value": "com.opencompare.app"
    },
    {
      "id": "builder-product-name",
      "path": "productName",
      "value": "OpenCompare"
    },
    {
      "id": "builder-mac-icon",
      "path": "mac.icon",
      "value": "build/icon.icns",
      "mustExist": true
    },
    {
      "id": "builder-win-icon",
      "path": "win.icon",
      "value": "build/icon.ico",
      "mustExist": true
    },
    {
      "id": "builder-linux-icon",
      "path": "linux.icon",
      "value": "build/icon.png",
      "mustExist": true
    },
    {
      "id": "builder-mac-target",
      "path": "mac.target",
      "value": [
        "dmg",
        "zip"
      ]
    },
    {
      "id": "builder-win-target",
      "path": "win.target",
      "value": [
        "nsis",
        "zip"
      ]
    },
    {
      "id": "builder-linux-target",
      "path": "linux.target",
      "value": [
        "AppImage",
        "deb"
      ]
    },
    {
      "id": "builder-nsis-artifact",
      "path": "nsis.artifactName",
      "value": "${productName}-Setup-${version}.${ext}"
    },
    {
      "id": "builder-win-artifact",
      "path": "win.artifactName",
      "value": "${productName}-${version}-win-${arch}.${ext}"
    },
    {
      "id": "builder-extra-resources",
      "path": "extraResources",
      "value": [
        {
          "from": "build/icon.png",
          "to": "icon.png"
        }
      ]
    },
    {
      "id": "builder-protocols",
      "path": "protocols",
      "value": [
        {
          "name": "OpenCompare Compare Link",
          "schemes": [
            "opencompare"
          ]
        }
      ]
    },
    {
      "id": "builder-linux-mime",
      "path": "linux.desktop.entry.MimeType",
      "value": "x-scheme-handler/opencompare"
    }
  ],
  "iconPolicy": {
    "id": "builder-icon-policy",
    "requiredPrefix": "build/",
    "forbiddenPattern": "electron\\.(icns|ico|png)",
    "electronCandidates": [
      "node_modules/electron/dist/Electron.app/Contents/Resources/electron.icns",
      "node_modules/electron/dist/resources/electron.icns"
    ]
  },
  "sources": [
    {
      "id": "main-window-icon",
      "path": "src/main/index.ts",
      "patterns": [
        "resolveBrandIconPath\\(",
        "icon:\\s*iconPath",
        "app\\.dock\\?\\.setIcon\\(iconPath\\)"
      ],
      "absentPatterns": []
    },
    {
      "id": "main-about-panel",
      "path": "src/main/index.ts",
      "patterns": [
        "app\\.setAboutPanelOptions\\(",
        "app\\.getVersion\\(\\)"
      ],
      "absentPatterns": [
        "\\b\\d+\\.\\d+\\.\\d+\\b",
        "Electron"
      ]
    },
    {
      "id": "brand-module-version-free",
      "path": "src/shared/brand.ts",
      "patterns": [
        "export const BRAND_NAME"
      ],
      "absentPatterns": [
        "\\b\\d+\\.\\d+\\.\\d+\\b"
      ]
    }
  ],
  "steps": [
    {
      "id": "mac-app-identity",
      "job": "release",
      "name": "Locate the packaged app and assert its icon and version",
      "if": "matrix.target == 'mac'",
      "tokens": [
        "find release -maxdepth 2 -name 'OpenCompare.app'",
        "No OpenCompare.app found",
        "::error::",
        "exit 1",
        "CFBundleIconFile",
        "electron.icns",
        "PlistBuddy -c 'Print :CFBundleIconFile'",
        "Contents/Resources/",
        "head -c 4",
        "icns",
        "node_modules/electron/dist/Electron.app/Contents/Resources/electron.icns",
        "shasum -a 256",
        "skipping the SHA-256 default-icon comparison",
        "Contents/Resources/icon.png",
        "build/icon.png",
        "does not match build/icon.png",
        "CFBundleIdentifier",
        "com.opencompare.app",
        "CFBundleShortVersionString",
        "${RELEASE_TAG#v}"
      ],
      "absent": [],
      "patterns": [],
      "absentPatterns": [
        "mac-arm64",
        "mac-x64"
      ]
    },
    {
      "id": "mac-signature",
      "job": "release",
      "name": "Verify the app signature, notarization and Gatekeeper acceptance",
      "if": "matrix.target == 'mac'",
      "tokens": [
        "codesign --verify --deep --strict --verbose=2",
        "codesign --verify --deep --strict failed",
        "::error::",
        "exit 1",
        "codesign -dv --verbose=4",
        "Authority=Developer ID Application",
        "TeamIdentifier=3X4J53U6RY",
        "Signature=adhoc",
        "(runtime)",
        "xcrun stapler validate",
        "hdiutil attach -nobrowse -readonly",
        "hdiutil detach",
        "trap detach_dmg EXIT",
        "find release -maxdepth 1 -name '*.dmg'",
        "spctl -a -vv --type execute",
        "accepted",
        "Notarized Developer ID"
      ],
      "absent": [],
      "patterns": [],
      "absentPatterns": []
    },
    {
      "id": "version-artifacts",
      "job": "release",
      "name": "Assert packaged version matches the tag",
      "tokens": [
        "case \"${{ matrix.target }}\" in",
        "mac) required_exts=(dmg zip)",
        "win) required_exts=(exe zip)",
        "linux) required_exts=(AppImage deb)",
        "[0-9]+\\.[0-9]+\\.[0-9]+",
        "does not match tag",
        "files=(release/latest*.yml)",
        "No latest*.yml update metadata found",
        "String(metadata.version) !== tag",
        "files[].url",
        "files[].path",
        "path ${metadata.path}",
        "update metadata does not match tag",
        "files[].url ${url} does not match tag"
      ],
      "absent": [],
      "patterns": [],
      "absentPatterns": []
    },
    {
      "id": "windows-feed",
      "job": "release",
      "name": "Assert the Windows update feed points at the NSIS installer",
      "if": "matrix.target == 'win'",
      "tokens": [
        "release/latest*.yml",
        "files[].url",
        "endsWith(\".zip\")",
        "exit 1"
      ],
      "absent": [],
      "patterns": [],
      "absentPatterns": [
        "gh release (upload|edit|create|delete)"
      ]
    },
    {
      "id": "build-installers",
      "job": "release",
      "name": "Build installers",
      "tokens": [
        "electron-builder --${{ matrix.target }} --publish never"
      ],
      "absent": [
        "zip"
      ],
      "patterns": [],
      "absentPatterns": []
    },
    {
      "id": "upload-installers",
      "job": "release",
      "name": "Upload installers to the tag's release",
      "tokens": [
        "release/*.zip",
        "release/*.exe"
      ],
      "absent": [],
      "patterns": [],
      "absentPatterns": [
        "if:\\s*always\\(\\)"
      ]
    },
    {
      "id": "single-public-release",
      "job": "finalize",
      "name": "Verify the tag has exactly one public release",
      "tokens": [
        "gh api \"repos/${GITHUB_REPOSITORY}/releases\" --paginate | jq -s",
        ".[][]",
        "select(.draft)",
        "select(.prerelease)",
        "[ \"${count}\" -ne 1 ]",
        "[ \"${drafts}\" -ne 0 ]",
        "[ \"${prereleases}\" -ne 0 ]",
        "for value in \"${count}\" \"${drafts}\" \"${prereleases}\"",
        "^[0-9]+$",
        "::error::Could not count the releases",
        "exit 1"
      ],
      "absent": [
        "--slurp"
      ],
      "patterns": [],
      "absentPatterns": []
    },
    {
      "id": "platform-assets",
      "job": "finalize",
      "name": "Assert the public release has every platform asset",
      "tokens": [
        "has_exact_asset",
        "for asset in \"OpenCompare-Setup-${tag}.exe\" \"OpenCompare-${tag}-win-x64.zip\"; do",
        "if [ \"${name}\" = \"${wanted}\" ]; then return 0; fi",
        "is missing the Windows asset ${asset}",
        "! has_exact_asset \"${asset}\"",
        "latest-mac.yml latest.yml latest-linux.yml",
        "gh api \"repos/${GITHUB_REPOSITORY}/releases\" --paginate | jq -s -r",
        "gh api \"repos/${GITHUB_REPOSITORY}/releases/${release_id}/assets\" --paginate | jq -s -r",
        "if [ -z \"${release_id}\" ]",
        "while checking its assets",
        "if [ -z \"${assets}\" ]",
        "has no assets",
        "releases/${release_id}/assets",
        ".dmg",
        ".zip",
        ".exe",
        ".AppImage",
        ".deb",
        "latest-mac.yml",
        "latest.yml",
        "latest-linux.yml",
        "has_asset",
        "does not carry the tag version"
      ],
      "absent": [
        "--slurp"
      ],
      "patterns": [],
      "absentPatterns": []
    },
    {
      "id": "latest-published-release",
      "job": "finalize",
      "name": "Assert the tag is the latest published release",
      "tokens": [
        "gh release list --limit 1 --json tagName",
        "jq -r '.[0].tagName // empty'",
        "${RELEASE_TAG}",
        "[ -z \"${latest}\" ]",
        "::error::",
        "exit 1"
      ],
      "absent": [],
      "patterns": [],
      "absentPatterns": [
        "gh release (?:create|edit|delete|upload)",
        "--method\\s+(?:POST|PATCH|PUT|DELETE)"
      ]
    }
  ],
  "stepOrder": [
    {
      "id": "release-hardening-order",
      "names": [
        "Require macOS signing and notarization credentials",
        "Build installers",
        "Locate the packaged app and assert its icon and version",
        "Verify the app signature, notarization and Gatekeeper acceptance",
        "Assert packaged version matches the tag",
        "Upload installers to the tag's release"
      ],
      "mustBeLast": false,
      "job": "release"
    },
    {
      "id": "windows-feed-position",
      "names": [
        "Assert packaged version matches the tag",
        "Assert the Windows update feed points at the NSIS installer",
        "Upload installers to the tag's release"
      ],
      "mustBeLast": false,
      "job": "release"
    },
    {
      "id": "finalize-latest-last",
      "names": [
        "Make the tag's release public",
        "Assert the published release body is bilingual",
        "Assert the published release body links are absolute",
        "Verify the tag has exactly one public release",
        "Assert the public release has every platform asset",
        "Assert latest*.yml urls match the release assets",
        "Assert the tag is the latest published release"
      ],
      "mustBeLast": true,
      "job": "finalize"
    }
  ],
  "finalizeGates": [
    "Assert the published release body is bilingual",
    "Verify the tag has exactly one public release",
    "Assert the public release has every platform asset",
    "Assert latest*.yml urls match the release assets",
    "Assert the tag is the latest published release"
  ],
