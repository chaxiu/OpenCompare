  "windowsPackaging": {
    "render": [
      {
        "id": "win-installer-name",
        "builderPath": "nsis.artifactName",
        "arch": "x64",
        "ext": "exe",
        "expected": "OpenCompare-Setup-${version}.exe"
      },
      {
        "id": "win-portable-name",
        "builderPath": "win.artifactName",
        "arch": "x64",
        "ext": "zip",
        "expected": "OpenCompare-${version}-win-x64.zip"
      }
    ],
    "latestYml": {
      "versionLine": "version: ${version}",
      "filesLine": "files:",
      "setupUrl": "  - url: ${setupAsset}",
      "portableUrl": "  - url: ${portableAsset}",
      "shaLine": "    sha512: fixture",
      "sizeLine": "    size: 1",
      "pathLine": "path: ${setupAsset}",
      "sha512Line": "sha512: fixture"
    },
    "publishedAssets": [
      "OpenCompare-${version}.dmg",
      "OpenCompare-${version}-mac.zip",
      "${setupAsset}",
      "${portableAsset}",
      "OpenCompare-${version}.AppImage",
      "opencompare_${version}_amd64.deb",
      "latest-mac.yml",
      "latest.yml",
      "latest-linux.yml"
    ],
    "cases": [
      {
        "id": "win-version-pass",
        "script": "version",
        "artifacts": "both",
        "latest": "installer-only",
        "status": "zero",
        "tokens": [
          "release/latest.yml version=${version}"
        ],
        "absent": []
      },
      {
        "id": "win-version-missing-exe",
        "script": "version",
        "artifacts": "zip-only",
        "latest": "installer-only",
        "status": "nonzero",
        "tokens": [
          "::error::No .exe artifact found"
        ],
        "absent": []
      },
      {
        "id": "win-version-missing-zip",
        "script": "version",
        "artifacts": "exe-only",
        "latest": "installer-only",
        "status": "nonzero",
        "tokens": [
          "::error::No .zip artifact found"
        ],
        "absent": []
      },
      {
