{
  "name": "opencompare",
  "version": "0.2.14",
  "private": true,
  "description": "OpenCompare — 现代跨平台桌面对比与三向合并工具",
  "author": {
    "name": "OpenCompare Contributors",
    "email": "chaxiu@users.noreply.github.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/chaxiu/OpenCompare",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.mts",
    "build": "electron-vite build",
    "build:web": "vite build --config vite.web.config.mts",
    "preview:web": "vite preview --config vite.web.config.mts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "measure:symlink": "vitest run --config vitest.evidence.config.mts",
    "perf:dir": "electron-vite build && node scripts/perf-dir.mjs",
    "perf:gate": "electron-vite build && node scripts/perf-gate.mjs",
    "release:metadata": "node scripts/release-metadata.mjs",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "screenshots": "electron-vite build && node scripts/capture-readme-screenshots.mjs",
    "test:cancel": "vitest run src/cancel-gate.test.ts",
    "test:memory": "vitest run src/memory-gate.test.ts",
    "test:structured": "vitest run src/structured-semantics-gate.test.ts",
    "test:sync-real": "vitest run src/sync-real-gate.test.ts"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.21",
    "diff": "^9.0.0",
    "jsonc-parser": "^3.3.1",
    "node-diff3": "^3.2.1",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^37.10.3",
    "electron-builder": "^26.17.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
